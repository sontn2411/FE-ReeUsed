{
  "name": "reeused-website",
  "version": "1.0.0",
  "description": "Website tĩnh cho nền tảng mua bán đồ cũ & thanh lý ReeUsed (Eleventy + Tailwind CSS).",
  "private": true,
  "scripts": {
    "clean": "rimraf _site",
    "serve:eleventy": "npx @11ty/eleventy --serve",
    "serve": "npm-run-all clean serve:*",
    "build:eleventy": "npx @11ty/eleventy",
    "build": "npm-run-all clean build:eleventy",
    "images": "node scripts/optimize-images.mjs"
  },
  "keywords": [
    "eleventy",
    "11ty",
    "tailwindcss",
    "static-site",
    "reeused"
  ],
  "author": "ReeUsed",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.13"
  },
  "dependencies": {
    "eleventy-plugin-tailwindcss-4": "^2.0.1",
    "luxon": "^3.7.2"
  }
}
