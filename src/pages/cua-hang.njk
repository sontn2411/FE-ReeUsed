---
title: Cửa hàng
layout: layouts/base.njk
permalink: /cua-hang/
---

{% from "components/store/store-card.njk" import storeCard %}
{% from "components/icon.njk" import icon %}

{% include "components/store/store-banner.njk" %}

<!-- Hệ thống chi nhánh -->
<section class="stores-section py-4 sm:py-6">
  <div class="mb-5 sm:mb-7 flex items-center gap-3">
    <img
      src="/img/icon-store.webp"
      alt=""
      class="w-9 h-9 sm:w-10 sm:h-10 object-contain shrink-0"
      width="40"
      height="40"
      loading="lazy"
    >
    <div>
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">
        Hệ thống chi nhánh
      </h2>
      <p class="text-xs sm:text-sm text-gray-500 mt-1">
        6 cửa hàng trên toàn quốc, sẵn sàng phục vụ bạn mỗi ngày.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
    {% for s in stores %}
      {{ storeCard(s) }}
    {% endfor %}
  </div>
</section>
