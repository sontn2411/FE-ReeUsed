<!DOCTYPE html>
<html lang="vi" class="h-full">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Critical CSS for page loader (inline so it renders before external CSS) #}
    <style>
      #page-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #ffffff;
        transition: opacity 0.4s ease, visibility 0.4s ease;
      }
      #page-loader.is-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
      .page-loader-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #e5f3ea;
        border-top-color: #0a433c;
        border-radius: 50%;
        animation: page-loader-spin 0.8s linear infinite;
      }
      @keyframes page-loader-spin {
        to { transform: rotate(360deg); }
      }
      .page-loader-logo {
        margin-top: 16px;
        height: 32px;
        width: auto;
        object-fit: contain;
      }
      .page-loader-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
      }
    </style>

    {# SEO Title & Meta #}
    {% set pageTitle = (title ~ " | " ~ site.name) if (title and title != "Home" and title != site.name) else site.title %}
    {% set metaDescription = description or site.description %}
    {% set metaKeywords = keywords or site.keywords %}
    {% set canonicalUrl = site.url ~ page.url %}
    {% set metaImage = image or (site.url ~ site.ogImage) %}

    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    <meta name="keywords" content="{{ metaKeywords }}">
    <meta name="author" content="{{ author or site.author }}">
    <meta name="robots" content="{{ robots or 'index, follow' }}">
    <link rel="canonical" href="{{ canonicalUrl }}">

    {# Mobile & PWA Theme Colors #}
    <meta name="theme-color" content="{{ site.themeColor or '#0a433c' }}">
    <meta name="msapplication-TileColor" content="{{ site.themeColor or '#0a433c' }}">

    {# Favicon & Icons #}
    <link rel="icon" type="image/png" sizes="64x64" href="/img/favicon-64.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">

    {# Open Graph / Facebook #}
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:image" content="{{ metaImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:alt" content="{{ pageTitle }}">
    <meta property="og:locale" content="{{ site.locale or 'vi_VN' }}">

    {# Twitter Card #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <meta name="twitter:image" content="{{ metaImage }}">

    {# Schema.org Structured Data (JSON-LD) #}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}",
        "description": "{{ site.description }}",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "{{ site.url }}/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>

    <link rel="stylesheet" type="text/css" href="/assets/main.css" />
    {# CSS riêng cho từng page (chỉ load khi page khai báo) #}
    {% if extraCss %}
      {% set cssList = [extraCss] if extraCss is string else extraCss %}
      {% for css in cssList %}
        <link rel="stylesheet" type="text/css" href="{{ css }}" />
      {% endfor %}
    {% endif %}
  </head>
  <body class="h-full overflow-hidden">
    <!-- Global Page Loader (hiển thị khi tải JS/CSS) -->
    <div id="page-loader">
      <div class="page-loader-wrap">
        <div class="page-loader-spinner"></div>
        <img
          src="/img/logo.webp"
          alt="ReeUsed"
          class="page-loader-logo"
          width="120"
          height="36"
        >
      </div>
    </div>
    <script>
      (function () {
        var loader = document.getElementById("page-loader");
        if (!loader) return;
        function hide() {
          loader.classList.add("is-hidden");
          setTimeout(function () { if (loader.parentNode) loader.parentNode.removeChild(loader); }, 450);
        }
        // Ẩn khi trang load xong; tối đa 3s để tránh treo vĩnh viễn
        if (document.readyState === "complete") {
          hide();
        } else {
          window.addEventListener("load", hide, { once: true });
          setTimeout(hide, 3000);
        }
      })();
    </script>
    <!-- Mobile Left Offcanvas Navigation Drawer -->
    {% include "../components/mobile-nav.njk" %}

    <!-- Sticky Header: Pinned at top when scrolling -->
    <div id="sticky-header" class="fixed top-0 left-0 w-full z-50 bg-white hidden">
      <div class="container mx-auto px-2.5 sm:px-4 py-2 sm:py-3">
        {% include "../components/header.njk" %}
        <!-- Sticky Navbar: Slide down/up accordion on hamburger click -->
        <div id="sticky-navbar-collapse">
          <div class="sticky-navbar-inner">
            {% include "../components/navabar.njk" %}
          </div>
        </div>
      </div>
    </div>

    <!-- Smooth Scrollbar Container -->
    <div id="main" class="h-screen w-full overflow-y-auto scroll-smooth">
      <!-- Original Header: Natural flow header at page top -->
      <div id="original-header" class="w-full bg-white">
        <!-- Top Announcement Bar: Chứa địa chỉ & số điện thoại, không dính khi cuộn -->
        {% include "../components/top-bar.njk" %}

        <div class="container mx-auto px-2.5 sm:px-4 py-2 sm:py-3">
          {% include "../components/header.njk" %}
          {% include "../components/navabar.njk" %}
        </div>
      </div>

      <main class="container mx-auto px-2.5 sm:px-4 py-2 sm:py-3 pb-8">
        {{ content | safe }}
      </main>

      <!-- Footer Component -->
      {% include "../components/footer.njk" %}
    </div>
    <!-- Auth Modal (Đăng nhập / Đăng ký) — available on all pages via header button -->
    {% include "../components/auth-modal.njk" %}


    <!-- Floating Action Group: Social Contact Buttons & Back to Top -->
    <div class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-[60] flex flex-col items-center gap-2.5 sm:gap-3">
      {% include "../components/floating-socials.njk" %}
      {% include "../components/back-to-top.njk" %}
    </div>

    <script src="/js/main.js"></script>
    <script src="/js/auth-modal.js"></script>
    {# JS riêng cho từng page (chỉ load khi page khai báo) #}
    {% if extraJs %}
      {% set jsList = [extraJs] if extraJs is string else extraJs %}
      {% for js in jsList %}
        <script src="{{ js }}"></script>
      {% endfor %}
    {% endif %}
  </body>
</html>
