{% from "components/icon.njk" import icon %}

<!-- Mobile Offcanvas Navigation Drawer (Slides in from the left) -->
<div id="mobile-nav" class="fixed inset-0 z-[100] transition-all duration-300 pointer-events-none" aria-hidden="true">
  <!-- Backdrop overlay -->
  <div id="mobile-nav-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs opacity-0 transition-opacity duration-300 pointer-events-none z-10"></div>

  <!-- Left slide-out panel -->
  <aside id="mobile-nav-panel" class="fixed inset-y-0 left-0 w-[290px] sm:w-[320px] max-w-[85vw] bg-white shadow-2xl flex flex-col z-20 pointer-events-auto">
    <!-- Mobile Drawer Header: Brand Logo & Close Button -->
    <div class="flex items-center justify-between px-4 py-3.5 border-b border-gray-100 shrink-0">
      <a href="/" class="flex items-center gap-2" aria-label="ReeUsed Trang chủ">
        <img
          src="/img/logo.webp"
          alt="ReeUsed Logo"
          class="h-8 w-auto object-contain"
          width="480"
          height="111"
          loading="lazy"
        >
      </a>
      <button
        type="button"
        id="mobile-nav-close"
        class="p-2 -mr-1.5 text-gray-400 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors cursor-pointer"
        aria-label="Đóng menu"
        title="Đóng menu"
      >
        {{ icon("close", "w-5 h-5") }}
      </button>
    </div>

    <!-- Drawer Body (Scrollable container) -->
    <div class="flex-1 overflow-y-auto overscroll-contain px-3 py-4 space-y-6 no-scrollbar">
      <!-- Section 1: Main Navigation Links -->
      <div>
        <div class="px-2 pb-2 text-[11px] font-bold tracking-wider text-gray-400 uppercase">
          Trang điều hướng
        </div>
        <ul class="space-y-1">
          {% for item in navLinks %}
            {% set isActive = (page.url == item.url) %}
            <li>
              <a
                href="{{ item.url }}"
                class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all {% if isActive %}bg-emerald-50 text-primary font-bold border-l-4 border-primary shadow-xs{% else %}text-gray-700 hover:text-primary hover:bg-gray-50{% endif %}"
              >
                <span>{{ item.label }}</span>
                <span class="text-gray-400 {% if isActive %}text-primary{% endif %}">
                  {{ icon("chevron-right", "w-4 h-4") }}
                </span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Section 2: Explore Product Categories -->
      <div>
        <div class="flex items-center gap-2 px-2 pb-2 text-[11px] font-bold tracking-wider text-gray-400 uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
          <span>Danh mục sản phẩm</span>
        </div>
        <div class="space-y-1">
          {% for cat in categories %}
            <a
              href="/categories/{{ cat.value | default('') }}"
              class="mobile-nav-link flex items-center justify-between px-3 py-2 text-xs font-medium rounded-xl text-gray-700 hover:text-primary hover:bg-emerald-50/70 transition-all group"
            >
              <div class="flex items-center gap-3 truncate">
                {% if cat.icon %}
                  <img
                    src="{{ cat.icon }}"
                    alt="{{ cat.label }}"
                    class="w-4 h-4 object-contain shrink-0"
                    loading="lazy"
                  >
                {% else %}
                  <span class="w-2 h-2 rounded-full bg-gray-300 group-hover:bg-primary transition-colors shrink-0"></span>
                {% endif %}
                <span class="truncate">{{ cat.label }}</span>
              </div>
              <span class="text-gray-300 group-hover:text-primary group-hover:translate-x-0.5 transition-all">
                {{ icon("chevron-right", "w-3.5 h-3.5") }}
              </span>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Drawer Footer: Login/Register & Support Info -->
    <div class="p-4 border-t border-gray-100 bg-gray-50/70 shrink-0 space-y-2.5">
      <button
        type="button"
        class="w-full flex items-center justify-center gap-2 bg-primary text-white py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold hover:opacity-95 shadow-sm active:scale-[0.99] transition-all cursor-pointer"
        aria-label="Đăng nhập / Đăng ký"
      >
        {{ icon("user", "w-4 h-4 text-white") }}
        <span>Đăng nhập / Đăng ký</span>
      </button>
      <p class="text-[11px] text-center text-gray-400">
        Nền tảng thanh lý đồ cũ văn minh ReeUsed
      </p>
    </div>
  </aside>
</div>
