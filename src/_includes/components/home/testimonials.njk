{% from "../icon.njk" import icon %}

<!-- Community Testimonials Section: "Cộng đồng nói gì về ReeUsed" -->
<section class="testimonials-section mb-12 sm:mb-16">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 sm:mb-10">
    <div class="flex flex-col gap-2">

      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">
        Cộng đồng nói gì về ReeUsed
      </h2>
      <p class="text-sm sm:text-base text-gray-500 max-w-xl leading-relaxed">
        Lắng nghe những chia sẻ và trải nghiệm thực tế từ các khách hàng đã mua bán, trao đổi tại ReeUsed.
      </p>
    </div>

    <!-- View All Link & Rating Summary -->
    <a
      href="/danh-gia/"
      class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-primary hover:text-emerald-700 transition-colors group/link self-start sm:self-auto shrink-0"
    >
      <span class="inline-flex items-center gap-1 text-amber-500 font-bold">
        {{ icon("star", "w-4 h-4 text-amber-400") }}
        <span class="text-gray-900">4.9/5</span>
      </span>
      <span class="text-gray-300">•</span>
      <span>Xem tất cả 2.000+ đánh giá</span>
      {{ icon("chevron-right", "w-4 h-4 transition-transform duration-200 group-hover/link:translate-x-0.5") }}
    </a>
  </div>

  <!-- Testimonials Grid (4 cards) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
    {% set reviews = testimonials or [] %}
    {% for item in reviews %}
      <div class="bg-white rounded-2xl border border-gray-150 p-5 sm:p-6 flex flex-col justify-between shadow-xs hover:shadow-xl hover:border-emerald-300 hover:-translate-y-1 transition-all duration-300 relative group overflow-hidden">
        
        <!-- Subtle Quote Watermark -->
        <div class="absolute top-4 right-4 text-emerald-900/[0.04] group-hover:text-emerald-900/[0.08] transition-colors pointer-events-none">
          {{ icon("quote", "w-12 h-12") }}
        </div>

        <!-- Top Content -->
        <div class="relative z-10 flex flex-col">
          <!-- Stars & Date -->
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-0.5 text-amber-400">
              {% for i in range(0, item.rating or 5) %}
                {{ icon("star", "w-3.5 h-3.5") }}
              {% endfor %}
            </div>
            <span class="text-[11px] text-gray-400 font-medium">
              {{ item.date }}
            </span>
          </div>

          <!-- Comment Text -->
          <p class="text-sm text-gray-600 leading-relaxed italic mb-5 line-clamp-5">
            “{{ item.comment }}”
          </p>
        </div>

        <!-- Author Information Footer -->
        <div class="pt-3.5 border-t border-gray-100 flex items-center justify-between gap-2 relative z-10 mt-auto">
          <div>
            <span class="font-bold text-sm text-gray-900 truncate block group-hover:text-primary transition-colors">
              {{ item.name }}
            </span>
            {% if item.location %}
              <span class="text-[11px] text-gray-400 truncate block mt-0.5">
                {{ item.location }}
              </span>
            {% endif %}
          </div>
        </div>

      </div>
    {% endfor %}
  </div>
</section>
