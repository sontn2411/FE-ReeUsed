{% from "components/icon.njk" import icon %}

<!-- Các hình thức thu mua -->
<section class="py-8 sm:py-10">
  <div class="mb-5 sm:mb-7">
    <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">
      Các hình thức thu mua
    </h2>
    <p class="text-xs sm:text-sm text-gray-500 mt-1">
      Chọn cách thu mua tiện lợi nhất cho bạn — tại cửa hàng, tận nhà hay từ xa.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    {% for method in buybackMethods %}
      <div class="group flex flex-col bg-gray-50  rounded-md p-4 sm:p-5 hover:bg-primary hover:border-primary transition-all duration-200 cursor-default">
        <!-- Icon -->
        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#e5f3ea] group-hover:bg-white/20 flex items-center justify-center mb-3 shrink-0 transition-colors duration-200">
          {{ icon(method.icon, "w-5 h-5 sm:w-6 sm:h-6 text-primary group-hover:text-white transition-colors duration-200") }}
        </div>

        <h3 class="font-bold text-sm sm:text-base text-gray-900 group-hover:text-white transition-colors duration-200">
          {{ method.title }}
        </h3>
        <p class="text-xs sm:text-sm text-gray-500 group-hover:text-white/80 mt-1.5 leading-relaxed flex-1 transition-colors duration-200">
          {{ method.desc }}
        </p>

        <!-- Note -->
        <div class="mt-3 inline-flex items-center gap-1.5 w-fit max-w-full bg-[#d7e7de] group-hover:bg-white/15 text-primary group-hover:text-white rounded-md px-2.5 py-1.5 transition-colors duration-200">
          {{ icon(method.noteIcon, "w-3.5 h-3.5 shrink-0 text-primary group-hover:text-white transition-colors duration-200") }}
          <span class="text-[11px] sm:text-xs font-bold">
            {{ method.note }}
          </span>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
