{#
  Component: Input Text (Ô nhập liệu tái sử dụng đa năng)
  
  Cách dùng 1: Macro (Khuyên dùng)
  {% from "components/input.njk" import input %}
  {{ input(
    name = "fullName",
    label = "Họ và tên",
    placeholder = "Nhập họ và tên của bạn",
    required = true
  ) }}

  Cách dùng 2: Include
  {% set name = "fullName" %}
  {% set label = "Họ và tên" %}
  {% set placeholder = "Nhập họ và tên của bạn" %}
  {% set required = true %}
  {% include "components/input.njk" %}
#}

{%
  macro input(
    name = "",
    id = "",
    label = "",
    type = "text",
    placeholder = "",
    value = "",
    required = false,
    class = "",
    wrapperClass = "",
    autocomplete = "",
    disabled = false,
    readonly = false
  )
%}
  {% set inputId = id or name or ("input-" ~ [1, 2, 3, 4, 5, 6, 7, 8, 9] | random) %}
  {% set inputType = type or "text" %}

  <div class="relative {{ wrapperClass }}">
    {% if label %}
      <label
        for="{{ inputId }}"
        class="absolute -top-2.5 left-4 px-2.5 py-0.5 bg-white border border-slate-200/90 rounded-md text-[11px] sm:text-xs font-semibold text-slate-700 z-10 shadow-3xs flex items-center gap-1 select-none pointer-events-none"
      >
        <span>{{ label }}</span>
        {% if required %}
          <span class="text-slate-400">*</span>
        {% endif %}
      </label>
    {% endif %}

    <input
      type="{{ inputType }}"
      id="{{ inputId }}"
      name="{{ name }}"
      value="{{ value }}"
      placeholder="{{ placeholder }}"
      {% if required %}required{% endif %}
      {% if disabled %}disabled{% endif %}
      {% if readonly %}readonly{% endif %}
      {% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
      class="w-full px-4 pt-3.5 pb-3 rounded-md bg-[#fbfdfc] border border-slate-200/90 text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all outline-none disabled:bg-slate-100 disabled:cursor-not-allowed {{ class }}"
    />
  </div>
{% endmacro %}

{# Hỗ trợ sử dụng qua include #}
{% if name or label %}
  {{ input(
    name = name,
    id = id,
    label = label,
    type = type,
    placeholder = placeholder,
    value = value,
    required = required,
    class = class,
    wrapperClass = wrapperClass,
    autocomplete = autocomplete,
    disabled = disabled,
    readonly = readonly
  ) }}
{% endif %}
