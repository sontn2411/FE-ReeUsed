{% from "components/icon.njk" import icon %}

<nav class="hidden md:flex py-1.5 sm:py-2.5 mt-1 items-center justify-between gap-2 sm:gap-4 w-full">
  <div class="flex items-center gap-2 sm:gap-4 md:gap-6 w-full">
    <!-- Product Categories Dropdown -->
    <details class="relative navbar-category-dropdown group shrink-0 z-40">
      <summary class="btn-noise list-none [&::-webkit-details-marker]:hidden flex items-center gap-2 sm:gap-3 bg-primary text-white text-xs sm:text-sm font-semibold px-3 sm:px-5 py-2 sm:py-2.5 rounded-lg cursor-pointer select-none hover:opacity-95 transition-all shadow-sm">
        <span class="pointer-events-none flex items-center">
          {{ icon("menu", "w-4 h-4 sm:w-5 sm:h-5 text-white") }}
        </span>
        <span class="whitespace-nowrap pointer-events-none">Danh mục sản phẩm</span>
        <span class="text-white/80 group-open:rotate-180 transition-transform duration-200 pointer-events-none flex items-center">
          {{ icon("chevron-down", "w-3.5 h-3.5 sm:w-4 sm:h-4") }}
        </span>
      </summary>
      <div class="absolute left-0 top-full mt-2 w-72 max-w-[calc(100vw-2rem)] bg-white/95 backdrop-blur-md rounded-2xl shadow-[0_12px_40px_-8px_rgba(0,0,0,0.15)] border border-gray-100 p-2 z-50">
        <div class="px-3 py-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-wider">
          Khám phá theo danh mục
        </div>

        <div class="space-y-1 max-h-80 overflow-y-auto overscroll-contain pr-1">
          {% for cat in categories %}
            <a
              href="/categories/{{ cat.value | default('') }}"
              class="flex items-center justify-between px-3 py-2 text-xs font-medium rounded-xl text-gray-700 hover:text-primary hover:bg-emerald-50/70 transition-all group/item"
            >
              <div class="flex items-center gap-2.5 truncate">
                {% if cat.icon %}
                  <img
                    src="{{ cat.icon }}"
                    alt="{{ cat.label }}"
                    class="w-4 h-4 object-contain shrink-0"
                    loading="lazy"
                  >
                {% endif %}
                <span class="truncate">{{ cat.label }}</span>
              </div>
              <span class="text-gray-300 group-hover/item:text-primary group-hover/item:translate-x-0.5 transition-all">
                {{ icon("chevron-right", "w-3 h-3") }}
              </span>
            </a>
          {% endfor %}
        </div>
      </div>
    </details>

    <!-- Main Navigation Links List -->
    <ul class="flex items-center gap-1 sm:gap-2 lg:gap-3 overflow-x-auto no-scrollbar whitespace-nowrap py-1 scroll-smooth min-w-0 flex-1">
      {% for item in navLinks %}
        {% set isActive = (page.url == item.url) %}
        <li class="shrink-0">
          <a
            href="{{ item.url }}"
            class="nav-link-animated px-2.5 sm:px-3.5 py-1.5 sm:py-2 text-xs sm:text-sm inline-flex items-center select-none text-gray-700 hover:text-primary transition-colors font-medium {% if isActive %}is-active{% endif %}"
          >
            {{ item.label }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</nav>

<!-- Auto-close category dropdown when clicking outside -->
<script>
  if (!window._navbarCategoryInit) {
    window._navbarCategoryInit = true;
    document.addEventListener("click", function(e) {
      document.querySelectorAll(".navbar-category-dropdown[open]").forEach(function(el) {
        if (!el.contains(e.target)) {
          el.removeAttribute("open");
        }
      });
    });
  }
</script>
