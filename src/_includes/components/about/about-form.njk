{#
  Component Section 2 cột cho trang About / Liên hệ:
  - Item 1: Form Gửi tin nhắn cho chúng tôi (khớp chính xác giao diện)
  - Item 2: Khung chứa sẵn cho nội dung sẽ thêm vào sau
#}
{% set formData = about.contactForm if about and about.contactForm else {} %}
{% set formTitle = formData.title or "Gửi tin nhắn cho chúng tôi" %}
{% set formSubtitle = formData.subtitle or "Hãy để lại thông tin, chúng tôi sẽ liên hệ lại với bạn sớm nhất!" %}
{% set formTopics = formData.topics or [
  "Tư vấn mua đồ cũ",
  "Hỗ trợ đăng tin bán",
  "Định giá & kiểm định chất lượng",
  "Hợp tác & đóng góp ý kiến",
  "Vấn đề tài khoản & thanh toán",
  "Khác"
] %}

<section class="about-form-section pb-12 sm:pb-20">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 items-stretch">
    
    <!-- Item 1: Form liên hệ -->
    <div class="bg-white rounded-md   p-6 sm:p-8 md:p-9 shadow-sm">
      
      <!-- Form Header -->
      <div class="flex items-start gap-3 sm:gap-3.5 mb-6 sm:mb-8">
        <img
          src="/img/paper-plane.svg"
          alt="Gửi tin nhắn"
          class="w-10 h-10 sm:w-11 sm:h-11 object-contain shrink-0 mt-0.5"
          width="44"
          height="44"
          loading="lazy"
        />
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
            {{ formTitle }}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            {{ formSubtitle }}
          </p>
        </div>
      </div>

      <!-- Form Inputs -->
      <form action="#" method="POST" class="space-y-5 sm:space-y-6" onsubmit="event.preventDefault();">
        
{% from "components/input.njk" import input %}
{% from "components/form-select.njk" import formSelect %}
{% from "components/icon.njk" import icon %}

        <!-- Row: Họ và tên & Email -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
          {{ input(
            name = "fullName",
            id = "contact-name",
            label = "Họ và tên",
            type = "text",
            placeholder = "Nhập họ và tên của bạn",
            required = true
          ) }}

          {{ input(
            name = "email",
            id = "contact-email",
            label = "Email",
            type = "email",
            placeholder = "Nhập email của bạn",
            required = true
          ) }}
        </div>

        <!-- Số điện thoại -->
        {{ input(
          name = "phone",
          id = "contact-phone",
          label = "Số điện thoại",
          type = "tel",
          placeholder = "Nhập số điện thoại của bạn",
          required = true
        ) }}

        <!-- Chủ đề (Select dropdown tùy biến theo style search) -->
        {{ formSelect(
          name = "topic",
          id = "contact-topic",
          label = "Chủ đề",
          placeholder = "Chọn chủ đề",
          options = formTopics,
          required = true
        ) }}

        <!-- Nội dung (Textarea) -->
        <div class="relative">
          <label for="contact-message" class="absolute -top-2.5 left-4 px-2.5 py-0.5 bg-white border border-slate-200/90 rounded-md text-[11px] sm:text-xs font-semibold text-slate-700 z-10 shadow-3xs flex items-center gap-1 select-none">
            <span>Nội dung</span>
            <span class="text-slate-400">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            required
            placeholder="Nhập nội dung tin nhắn..."
            class="w-full px-4 pt-4 pb-3 rounded-md bg-[#fbfdfc] border border-slate-200/90 text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all outline-none resize-y min-h-[120px]"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full py-3.5 sm:py-4 px-6 rounded-md bg-primary text-white font-bold text-sm sm:text-base flex items-center justify-center gap-2 hover:bg-emerald-800 active:scale-[0.99] transition-all shadow-md cursor-pointer mt-2"
        >
          {{ icon("paper-plane", "w-4 h-4 sm:w-5 sm:h-5 text-white -rotate-45") }}
          <span>Gửi tin nhắn</span>
        </button>

        <!-- Security Footnote -->
        <div class="flex items-center justify-center gap-1.5 text-xs text-slate-500 text-center pt-1">
          {{ icon("lock", "w-3.5 h-3.5 text-slate-400 shrink-0") }}
          <span>Thông tin của bạn được bảo mật tuyệt đối.</span>
        </div>

      </form>
    </div>

    <!-- Item 2: Chia đều 3 item nhỏ xếp dọc chiếm trọn chiều cao -->
    <div id="about-section-item-2" class="w-full h-full flex flex-col gap-5 sm:gap-6">
      
      <!-- Sub-item 1: Banner / Thẻ bản đồ có họa tiết map-01.png -->
      <div class="flex-1 min-h-[160px] relative overflow-hidden rounded-md p-6 sm:p-7 bg-[#e8f5ec] shadow-sm flex flex-col justify-center">
        
        <!-- Họa tiết trang trí map-01.png ở bên phải (căn giữa theo chiều dọc, không sát mép) -->
        <img
          src="/img/map-01.png"
          alt=""
          aria-hidden="true"
          class="absolute right-3 sm:right-6 md:right-8 top-1/2 -translate-y-1/2 w-36 sm:w-44 md:w-48 max-h-[88%] object-contain pointer-events-none select-none sm:opacity-95 z-0 transition-all"
          loading="lazy"
        />

        <div class="relative z-10 max-w-[60%] sm:max-w-[65%] flex flex-col items-start text-left gap-2 sm:gap-2.5">
          
          <!-- Hàng 1: Icon và Title -->
          <div class="flex items-center gap-2 sm:gap-2.5">
            <img
              src="/img/icon-store.png"
              alt="Cửa hàng"
              class="w-5 h-5 sm:w-6 sm:h-6 object-contain shrink-0"
              width="24"
              height="24"
              loading="lazy"
            />
            <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">
              Danh sách cửa hàng
            </h3>
          </div>

          <!-- Hàng 2: Description -->
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Khám phá hệ thống điểm giao dịch và cửa hàng ReeUsed gần bạn nhất để trải nghiệm trực tiếp.
          </p>

          <!-- Hàng 3: Button Outline (Icon + CTA điều hướng đến trang cửa hàng) -->
          <a
            href="/cua-hang/"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-md border border-primary text-primary hover:bg-primary hover:text-white transition-all text-xs sm:text-sm font-bold shadow-3xs cursor-pointer mt-0.5 active:scale-95"
          >
            {{ icon("location", "w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0") }}
            <span>Xem cửa hàng</span>
            {{ icon("chevron-right", "w-3 h-3 sm:w-3.5 sm:h-3.5 shrink-0") }}
          </a>

        </div>
      </div>

      <!-- Sub-item 2: FAQ / Câu hỏi thường gặp có họa tiết faq-01.png -->
      <div class="flex-1 min-h-[160px] relative overflow-hidden rounded-md p-6 sm:p-7 bg-[#e8f5ec] shadow-sm flex flex-col justify-center">
        
        <!-- Họa tiết trang trí faq-01.png ở bên phải (căn giữa theo chiều dọc, không sát mép) -->
        <img
          src="/img/faq-01.png"
          alt=""
          aria-hidden="true"
          class="absolute right-3 sm:right-6 md:right-8 top-1/2 -translate-y-1/2 w-36 sm:w-44 md:w-48 max-h-[88%] object-contain pointer-events-none select-none sm:opacity-95 z-0 transition-all"
          loading="lazy"
        />

        <div class="relative z-10 max-w-[60%] sm:max-w-[65%] flex flex-col items-start text-left gap-2 sm:gap-2.5">
          
          <!-- Hàng 1: Icon và Title -->
          <div class="flex items-center gap-2 sm:gap-2.5">
            <img
              src="/img/icon-faq.png"
              alt="FAQ"
              class="w-5 h-5 sm:w-6 sm:h-6 object-contain shrink-0"
              width="24"
              height="24"
              loading="lazy"
            />
            <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">
              Câu hỏi thường gặp
            </h3>
          </div>

          <!-- Hàng 2: Description -->
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Giải đáp nhanh chóng các thắc mắc về quy trình kiểm định, bảo hành và chính sách mua bán.
          </p>

          <!-- Hàng 3: Button Outline (Icon + CTA điều hướng đến trang FAQ) -->
          <a
            href="/faq/"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-md border border-primary text-primary hover:bg-primary hover:text-white transition-all text-xs sm:text-sm font-bold shadow-3xs cursor-pointer mt-0.5 active:scale-95"
          >
            {{ icon("help-circle", "w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0") }}
            <span>Xem câu hỏi</span>
            {{ icon("chevron-right", "w-3 h-3 sm:w-3.5 sm:h-3.5 shrink-0") }}
          </a>

        </div>
      </div>

      <!-- Sub-item 3: Policy / Chính sách & Quy định có họa tiết policy-01.png -->
      <div class="flex-1 min-h-[160px] relative overflow-hidden rounded-md p-6 sm:p-7 bg-[#e8f5ec] shadow-sm flex flex-col justify-center">
        
        <!-- Họa tiết trang trí policy-01.png ở bên phải (căn giữa theo chiều dọc, không sát mép) -->
        <img
          src="/img/policy-01.png"
          alt=""
          aria-hidden="true"
          class="absolute right-3 sm:right-6 md:right-8 top-1/2 -translate-y-1/2 w-36 sm:w-44 md:w-48 max-h-[88%] object-contain pointer-events-none select-none sm:opacity-95 z-0 transition-all"
          loading="lazy"
        />

        <div class="relative z-10 max-w-[60%] sm:max-w-[65%] flex flex-col items-start text-left gap-2 sm:gap-2.5">
          
          <!-- Hàng 1: Icon và Title -->
          <div class="flex items-center gap-2 sm:gap-2.5">
            <img
              src="/img/icon-policy.png"
              alt="Chính sách & Quy định"
              class="w-5 h-5 sm:w-6 sm:h-6 object-contain shrink-0"
              width="24"
              height="24"
              loading="lazy"
            />
            <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">
              Chính sách & Quy định
            </h3>
          </div>

          <!-- Hàng 2: Description -->
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Tìm hiểu chi tiết các cam kết bảo hành, đổi trả minh bạch và quyền lợi khách hàng tại ReeUsed.
          </p>

          <!-- Hàng 3: Button Outline (Icon + CTA điều hướng đến trang chính sách) -->
          <a
            href="/chinh-sach-bao-hanh/"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-md border border-primary text-primary hover:bg-primary hover:text-white transition-all text-xs sm:text-sm font-bold shadow-3xs cursor-pointer mt-0.5 active:scale-95"
          >
            {{ icon("shield-check", "w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0") }}
            <span>Xem chính sách</span>
            {{ icon("chevron-right", "w-3 h-3 sm:w-3.5 sm:h-3.5 shrink-0") }}
          </a>

        </div>
      </div>

    </div>

  </div>
</section>
