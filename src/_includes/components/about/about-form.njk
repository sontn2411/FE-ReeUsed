{#
  Component Section 2 cột cho trang About / Liên hệ:
  - Item 1: Form Gửi tin nhắn cho chúng tôi (khớp chính xác giao diện)
  - Item 2: Khung chứa sẵn cho nội dung sẽ thêm vào sau
#}
{% set formData = about.contactForm if about and about.contactForm else {} %}
{% set formTitle = formData.title or "Gửi tin nhắn cho chúng tôi" %}
{% set formSubtitle = formData.subtitle or "Hãy để lại thông tin, chúng tôi sẽ liên hệ lại với bạn sớm nhất!" %}
{% set formTopics = formData.topics or [
  "Tư vấn mua đồ cũ",
  "Hỗ trợ đăng tin bán",
  "Định giá & kiểm định chất lượng",
  "Hợp tác & đóng góp ý kiến",
  "Vấn đề tài khoản & thanh toán",
  "Khác"
] %}

<section class="about-form-section pb-12 sm:pb-20">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 items-start">
    
    <!-- Item 1: Form liên hệ -->
    <div class="bg-white rounded-2xl sm:rounded-3xl  p-6 sm:p-8 md:p-9 shadow-sm">
      
      <!-- Form Header -->
      <div class="flex items-start gap-3 sm:gap-3.5 mb-6 sm:mb-8">
        <img
          src="/img/paper-plane.svg"
          alt="Gửi tin nhắn"
          class="w-10 h-10 sm:w-11 sm:h-11 object-contain shrink-0 mt-0.5"
          width="44"
          height="44"
          loading="lazy"
        />
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
            {{ formTitle }}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            {{ formSubtitle }}
          </p>
        </div>
      </div>

      <!-- Form Inputs -->
      <form action="#" method="POST" class="space-y-5 sm:space-y-6" onsubmit="event.preventDefault();">
        
{% from "components/input.njk" import input %}
{% from "components/form-select.njk" import formSelect %}

        <!-- Row: Họ và tên & Email -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
          {{ input(
            name = "fullName",
            id = "contact-name",
            label = "Họ và tên",
            type = "text",
            placeholder = "Nhập họ và tên của bạn",
            required = true
          ) }}

          {{ input(
            name = "email",
            id = "contact-email",
            label = "Email",
            type = "email",
            placeholder = "Nhập email của bạn",
            required = true
          ) }}
        </div>

        <!-- Số điện thoại -->
        {{ input(
          name = "phone",
          id = "contact-phone",
          label = "Số điện thoại",
          type = "tel",
          placeholder = "Nhập số điện thoại của bạn",
          required = true
        ) }}

        <!-- Chủ đề (Select dropdown tùy biến theo style search) -->
        {{ formSelect(
          name = "topic",
          id = "contact-topic",
          label = "Chủ đề",
          placeholder = "Chọn chủ đề",
          options = formTopics,
          required = true
        ) }}

        <!-- Nội dung (Textarea) -->
        <div class="relative">
          <label for="contact-message" class="absolute -top-2.5 left-4 px-2.5 py-0.5 bg-white border border-slate-200/90 rounded-md text-[11px] sm:text-xs font-semibold text-slate-700 z-10 shadow-3xs flex items-center gap-1 select-none">
            <span>Nội dung</span>
            <span class="text-slate-400">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            required
            placeholder="Nhập nội dung tin nhắn..."
            class="w-full px-4 pt-4 pb-3 rounded-xl sm:rounded-2xl bg-[#fbfdfc] border border-slate-200/90 text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all outline-none resize-y min-h-[120px]"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full py-3.5 sm:py-4 px-6 rounded-xl sm:rounded-2xl bg-primary text-white font-bold text-sm sm:text-base flex items-center justify-center gap-2 hover:bg-emerald-800 active:scale-[0.99] transition-all shadow-md cursor-pointer mt-2"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white -rotate-45" viewBox="0 0 24 24" fill="currentColor">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
          </svg>
          <span>Gửi tin nhắn</span>
        </button>

        <!-- Security Footnote -->
        <div class="flex items-center justify-center gap-1.5 text-xs text-slate-500 text-center pt-1">
          <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          <span>Thông tin của bạn được bảo mật tuyệt đối.</span>
        </div>

      </form>
    </div>

    <!-- Item 2: Khung chuẩn bị sẵn (Sẽ thêm vào sau) -->
    <div id="about-section-item-2" class="w-full">
      <div>
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4648.632465005183!2d106.68793079999999!3d10.8162907!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3175294afe032c3f%3A0x23bad52c80599a6f!2s2HandLand!5e1!3m2!1sen!2s!4v1792576107686!5m2!1sen!2s" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    </div>

  </div>
</section>
