{% from "components/icon.njk" import icon %}
{% from "components/input.njk" import input %}

<!-- Modal Đăng nhập / Đăng ký -->
<div
  id="auth-modal"
  data-modal
  role="dialog"
  aria-modal="true"
  aria-labelledby="auth-modal-title"
  class="hidden fixed inset-0 z-[100] overflow-y-auto p-4 bg-black/50 backdrop-blur-sm"
>
  <style>
    [data-modal] { opacity: 0; transition: opacity .2s ease; }
    [data-modal].is-open { opacity: 1; }
    [data-modal] .modal-card { transform: translateY(12px); transition: transform .2s ease; }
    [data-modal].is-open .modal-card { transform: translateY(0); }
    .auth-forms-track { transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
  </style>

  <div class="modal-card relative w-full max-w-4xl m-auto bg-white rounded-2xl shadow-2xl overflow-hidden">
    <!-- Nút đóng -->
    <button
      type="button"
      data-modal-close
      class="absolute top-3 right-3 z-20 w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 transition-colors"
      aria-label="Đóng"
    >
      {{ icon("close", "w-4 h-4") }}
    </button>

    <div class="grid grid-cols-1 md:grid-cols-2">
      <!-- Bên trái: logo trên, text-auth + bg-auth ở dưới cùng -->
      <div class="hidden md:flex flex-col justify-between bg-[#e5f3ea] min-h-[400px] px-6 py-8">
        <!-- Logo -->
        <img
          src="/img/logo.webp"
          alt="ReeUsed"
          class="h-10 sm:h-12 w-auto object-contain"
          width="160"
          height="48"
          loading="lazy"
        >

        <!-- Text họa tiết + bg-auth ở dưới cùng -->
        <div class="flex flex-col items-center gap-6 mt-auto">
          <img
            src="/img/text-auth.webp"
            alt="Văn bản trang trí"
            class="w-full max-w-[200px] sm:max-w-[240px] h-auto object-contain"
            width="400"
            height="200"
            loading="lazy"
          >
          <img
            src="/img/bg-auth.webp"
            alt="Họa tiết trang trí"
            class="w-full max-w-[280px] sm:max-w-[320px] h-auto object-contain"
            width="400"
            height="300"
            loading="lazy"
          >
        </div>
      </div>

      <!-- Bên phải: form -->
      <div class="p-6 sm:p-8">
        <h3 id="auth-modal-title" class="text-xl sm:text-2xl font-bold text-gray-900">
          Chào mừng bạn!
        </h3>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">Đăng nhập hoặc tạo tài khoản mới</p>

        <!-- Tabs: Đăng nhập / Đăng ký (với sliding indicator) -->
        <div class="mt-5 relative flex gap-1 p-1 bg-gray-100 rounded-lg">
          <!-- Sliding indicator -->
          <div
            id="auth-tab-indicator"
            class="absolute top-1 bottom-1 left-1 w-[calc(50%-4px)] bg-white rounded-md shadow-sm transition-transform duration-300 ease-in-out"
          ></div>

          <button
            type="button"
            data-auth-tab="login"
            class="auth-tab relative z-10 flex-1 py-2 text-sm font-semibold rounded-md transition-colors text-primary"
          >
            Đăng nhập
          </button>
          <button
            type="button"
            data-auth-tab="register"
            class="auth-tab relative z-10 flex-1 py-2 text-sm font-semibold rounded-md transition-colors text-gray-600"
          >
            Đăng ký
          </button>
        </div>

        <!-- Forms track (slide qua lại) -->
        <div class="mt-6 min-h-[360px] overflow-hidden">
          <div id="auth-forms-track" class="auth-forms-track flex" style="width: 200%;">
            <!-- Form Đăng nhập -->
            <form data-auth-form="login" class="w-1/2 shrink-0 space-y-5 px-0.5">
              {{ input(
                name = "loginEmail",
                id = "auth-login-email",
                label = "Email / Số điện thoại",
                type = "text",
                placeholder = "Nhập email hoặc số điện thoại",
                required = true,
                autocomplete = "username"
              ) }}

              {{ input(
                name = "loginPassword",
                id = "auth-login-password",
                label = "Mật khẩu",
                type = "password",
                placeholder = "Nhập mật khẩu",
                required = true,
                autocomplete = "current-password"
              ) }}

              <div class="flex items-center justify-between text-xs sm:text-sm">
                <label class="flex items-center gap-1.5 text-gray-600 cursor-pointer select-none">
                  <input type="checkbox" name="remember" class="w-4 h-4 rounded border-gray-300 text-primary focus:ring-primary/30">
                  <span>Ghi nhớ đăng nhập</span>
                </label>
                <a href="#" class="text-primary font-semibold hover:underline">Quên mật khẩu?</a>
              </div>

              <button
                type="submit"
                class="w-full inline-flex items-center justify-center gap-2 bg-primary hover:bg-[#07332e] text-white font-bold text-sm sm:text-base px-5 py-3 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 active:scale-[0.98]"
              >
                {{ icon("lock", "w-4 h-4") }}
                Đăng nhập
              </button>

              <p class="text-[11px] sm:text-xs text-gray-500 text-center">
                Chưa có tài khoản? <button type="button" data-auth-switch="register" class="text-primary font-semibold hover:underline">Đăng ký ngay</button>
              </p>
            </form>

            <!-- Form Đăng ký -->
            <form data-auth-form="register" class="w-1/2 shrink-0 space-y-5 px-0.5">
              {{ input(
                name = "registerEmail",
                id = "auth-register-email",
                label = "Email",
                type = "email",
                placeholder = "Nhập email của bạn",
                required = true,
                autocomplete = "email"
              ) }}

              {{ input(
                name = "registerPhone",
                id = "auth-register-phone",
                label = "Số điện thoại",
                type = "tel",
                placeholder = "Nhập số điện thoại",
                required = true,
                autocomplete = "tel"
              ) }}

              {{ input(
                name = "registerPassword",
                id = "auth-register-password",
                label = "Mật khẩu",
                type = "password",
                placeholder = "Tạo mật khẩu",
                required = true,
                autocomplete = "new-password"
              ) }}

              <button
                type="submit"
                class="w-full inline-flex items-center justify-center gap-2 bg-primary hover:bg-[#07332e] text-white font-bold text-sm sm:text-base px-5 py-3 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 active:scale-[0.98]"
              >
                {{ icon("send", "w-4 h-4") }}
                Đăng ký
              </button>

              <p class="text-[11px] sm:text-xs text-gray-500 text-center">
                Đã có tài khoản? <button type="button" data-auth-switch="login" class="text-primary font-semibold hover:underline">Đăng nhập</button>
              </p>
            </form>
          </div>
        </div>

        <!-- Trạng thái gửi thành công -->
        <div data-auth-success class="hidden text-center py-8">
          <div class="w-14 h-14 mx-auto rounded-full bg-[#e5f3ea] flex items-center justify-center mb-3">
            {{ icon("verified", "w-7 h-7 text-primary") }}
          </div>
          <h4 class="font-bold text-gray-900">Thành công!</h4>
          <p class="text-xs sm:text-sm text-gray-500 mt-1">Chúng tôi sẽ liên hệ với bạn sớm.</p>
        </div>
      </div>
    </div>
  </div>
</div>
