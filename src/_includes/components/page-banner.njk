

{% macro pageBanner(bannerUrl = "", title = "", desc = "", options = {}) %}
  {% from "components/icon.njk" import icon %}

  {% set defaultStats = [
    { icon: "shield-check", value: "100%", label: "Giao dịch an toàn" },
    { icon: "package", value: "50.000+", label: "Món đồ trao tay" },
    { icon: "heart", value: "Vì cộng đồng", label: "Cùng nhau tạo giá trị" }
  ] %}

  {% set finalUrl = bannerUrl or options.url or "/img/banner-about-1280.webp" %}
  {% set finalTitle = title or options.title or "Kết nối người mua và người bán" %}
  {% set titleHighlight = options.titleHighlight or options.title2 or "" %}
  {% set finalDesc = desc or options.desc or "" %}
  {% set finalAlt = options.alt or finalTitle or "Banner" %}
  {% set showStats = options.showStats if options.showStats is defined else true %}
  {% set finalStats = options.stats or defaultStats %}
  {% set hasGradient = options.hasGradient if options.hasGradient is defined else (options.gradient if options.gradient is defined else false) %}
  <section class="banner-hero-section pt-3 sm:pt-4 pb-6 sm:pb-8">
    <div class="relative w-full min-h-[260px] sm:min-h-[290px] md:min-h-[320px] lg:min-h-[340px] xl:min-h-[340px] xl:aspect-[1024/300] overflow-hidden rounded-xl sm:rounded-2xl shadow-sm  transition-shadow group select-none">
      
      <!-- Background Banner Image -->
      <img
        src="{{ finalUrl }}"
        alt="{{ finalAlt }}"
        class="absolute inset-0 w-full h-full object-cover object-right sm:object-center"
        loading="eager"
        fetchpriority="high"
      >

      <!-- Left Gradient Overlay: Phủ toàn bộ trên mobile, nửa trái trên desktop -->
      {% if hasGradient %}
        <div class="absolute inset-y-0 left-0 w-full sm:w-full md:w-[95%] lg:w-[68%] xl:w-[62%] pointer-events-none z-[1] bg-gradient-to-r from-[#cde3d5] via-[#cde3d5]/95 sm:via-[#cde3d5]/90 to-[#cde3d5]/80 sm:to-transparent"></div>
      {% endif %}

      <!-- Nội dung toàn banner (Breadcrumb + Title + Desc + Stats theo luồng flex dọc tự nhiên) -->
      <div class="relative z-10 w-full h-full min-h-[260px] sm:min-h-[290px] md:min-h-[320px] lg:min-h-[340px] xl:min-h-[340px] flex flex-col justify-between p-4 sm:p-7 md:p-8 lg:p-9 xl:p-10 pointer-events-none">
        
        <!-- Pinned Top Breadcrumb: Nằm trên cùng theo luồng, loại bỏ 100% nguy cơ bị tiêu đề đè lên -->
        <div class="pointer-events-auto shrink-0 mb-1 sm:mb-2">
          {% set breadcrumbTitle = options.breadcrumbTitle or options.crumb or finalTitle %}
          {% set breadcrumbs = options.breadcrumbs or breadcrumbs %}
          {% include "components/breadcrumb.njk" %}
        </div>

        <!-- Khối nội dung chính: Chiếm trọn 100% bề ngang trên mobile, nửa trái trên desktop -->
        <div class="w-full max-w-full sm:max-w-[90%] md:max-w-[80%] lg:max-w-[60%] xl:max-w-[48%] flex flex-col gap-1.5 sm:gap-2 md:gap-2.5 lg:gap-3 my-auto">
          
          <!-- Banner Title -->
          <h1 class="font-extrabold text-base sm:text-lg md:text-xl lg:text-2xl xl:text-3xl leading-snug sm:leading-tight tracking-tight">
            <span class="block text-slate-900 font-bold">{{ finalTitle }}</span>
            {% if titleHighlight %}
              <span class="block text-primary font-extrabold mt-0.5 sm:mt-1">{{ titleHighlight }}</span>
            {% endif %}
          </h1>

          <!-- Banner Description -->
          {% if finalDesc %}
            <p class="text-xs sm:text-xs md:text-sm text-slate-700 font-medium leading-relaxed">
              {{ finalDesc }}
            </p>
          {% endif %}

          <!-- Thống kê & Chỉ số uy tín (Render động từ data stats) -->
          {% if showStats and finalStats.length %}
            <div class="mt-1 sm:mt-2 md:mt-3 flex flex-wrap sm:flex-nowrap items-center gap-2.5 sm:gap-3.5 md:gap-4 lg:gap-6 pt-0.5 sm:pt-1">
              {% for item in finalStats %}
                <div class="flex items-center gap-1.5 sm:gap-2 md:gap-2.5">
                  <div class="w-6 h-6 sm:w-7 sm:h-7 md:w-8 md:h-8 lg:w-9 lg:h-9 rounded-full bg-emerald-800/10 flex items-center justify-center shrink-0">
                    {{ icon(item.icon, "w-3 h-3 sm:w-3.5 sm:h-3.5 md:w-4 md:h-4 lg:w-4.5 lg:h-4.5 text-emerald-800") }}
                  </div>
                  <div class="flex flex-col">
                    <span class="font-extrabold text-[10px] sm:text-xs md:text-sm lg:text-sm text-slate-900 leading-tight">{{ item.value }}</span>
                    <span class="text-[8px] sm:text-[9.5px] md:text-xs text-slate-600 font-medium leading-tight mt-0.5 whitespace-nowrap">{{ item.label }}</span>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}

{% if options.cta %}
            <div class="mt-3 sm:mt-4 pointer-events-auto">
              {% if options.cta.modal %}
                <button
                  type="button"
                  data-modal-open="{{ options.cta.modal }}"
                  class="btn-noise inline-flex items-center justify-center gap-2 bg-primary hover:bg-[#07332e] text-white font-bold text-xs sm:text-sm px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 active:scale-[0.98] w-fit"
                >
                  {{ icon(options.cta.icon or "send", "w-4 h-4") }}
                  <span>{{ options.cta.text }}</span>
                </button>
              {% else %}
                <a
                  href="{{ options.cta.url or '#' }}"
                  class="btn-noise inline-flex items-center justify-center gap-2 bg-primary hover:bg-[#07332e] text-white font-bold text-xs sm:text-sm px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 active:scale-[0.98] w-fit"
                >
                  {{ icon(options.cta.icon or "send", "w-4 h-4") }}
                  <span>{{ options.cta.text }}</span>
                </a>
              {% endif %}
            </div>
          {% endif %}

        </div>

      </div>
    </div>
  </section>
{% endmacro %}

{# Alias ngắn gọn #}
{% macro banner(bannerUrl, title, desc, options) %}
  {{ pageBanner(bannerUrl, title, desc, options) }}
{% endmacro %}
