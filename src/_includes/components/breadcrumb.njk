{#
  Breadcrumb Component: Dùng chung cho toàn trang web và banner
  Biến hỗ trợ:
  - breadcrumbTitle hoặc title: Tiêu đề trang hiện tại (nếu chỉ có 1 cấp)
  - breadcrumbs: Danh sách mảng [{ label: "...", url: "..." }] (nếu có nhiều cấp)
  - breadcrumbNavClass: Class tùy biến cho thẻ <nav>
  - breadcrumbListClass: Class tùy biến cho danh sách <ol>
#}
{% set currentCrumb = breadcrumbTitle or title or "Liên hệ" %}
{% set navClass = breadcrumbNavClass or "inline-flex" %}
{% set listClass = breadcrumbListClass or "inline-flex items-center gap-1.5 sm:gap-2 text-[10px] sm:text-xs text-slate-700 font-medium" %}

<nav aria-label="Breadcrumb" class="{{ navClass }}">
  <ol class="{{ listClass }}">
    <!-- Trang chủ -->
    <li class="inline-flex items-center">
      <a href="/" class="text-slate-600 hover:text-primary transition-colors flex items-center gap-1 font-medium">
        <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span>Trang chủ</span>
      </a>
    </li>

    <!-- Danh sách breadcrumb động -->
    {% if breadcrumbs and breadcrumbs.length %}
      {% for crumb in breadcrumbs %}
        <li class="text-slate-400 select-none">
          <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </li>
        {% if crumb.url and not loop.last %}
          <li>
            <a href="{{ crumb.url }}" class="text-slate-600 hover:text-primary transition-colors font-medium">
              {{ crumb.label or crumb.title }}
            </a>
          </li>
        {% else %}
          <li class="text-slate-700 font-bold truncate max-w-[140px] sm:max-w-none" aria-current="page">
            {{ crumb.label or crumb.title }}
          </li>
        {% endif %}
      {% endfor %}
    {% else %}
      <li class="text-slate-400 select-none">
        <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </li>
      <li class="text-slate-700 font-bold truncate max-w-[140px] sm:max-w-none" aria-current="page">
        {{ currentCrumb }}
      </li>
    {% endif %}
  </ol>
</nav>
