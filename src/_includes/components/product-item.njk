

{% macro productItem(product, badgeType = "auto", showOriginalPrice = true, class = "") %}
  {% from "components/icon.njk" import icon %}
  {% set targetUrl = product.url or "/cua-hang/" %}

  <div
    class="group relative flex flex-col bg-white rounded-2xl border border-gray-100 hover:border-emerald-300 p-2.5 sm:p-3 transition-all duration-300 hover:shadow-xl hover:-translate-y-1.5 shadow-md {{ class }}"
  >
    <!-- Product Image Container -->
    <div class="relative w-full aspect-square rounded-xl bg-gray-50 overflow-hidden flex items-center justify-center mb-2.5">
      <!-- Badge: Discount / New / Custom -->
      {% if badgeType == "discount" or (badgeType == "auto" and product.discount) %}
        {% if product.discount %}
          <span class="absolute top-2 left-2 z-10 inline-flex items-center px-1.5 sm:px-2 py-0.5 rounded-md text-[10px] sm:text-xs font-black bg-rose-600 text-white shadow-xs">
            {{ product.discount }}
          </span>
        {% endif %}
      {% elif badgeType == "new" or (badgeType == "auto" and not product.discount) %}
        <span class="absolute top-2 left-2 z-10 inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 rounded-md text-[10px] sm:text-xs font-bold bg-primary text-white shadow-xs">
          {{ icon("sparkles", "w-3 h-3 text-emerald-200") }}
          <span>Mới</span>
        </span>
      {% endif %}


      <!-- Product Image -->
      <a href="{{ targetUrl }}" class="w-full h-full flex items-center justify-center">
        <img
          src="{{ product.image }}"
          alt="{{ product.name }}"
          class="w-full h-full object-contain p-2.5 transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        >
      </a>
    </div>

    <!-- Product Content -->
    <div class="flex flex-col flex-1">
      <!-- Category & Location -->
      <div class="flex items-center justify-between text-[11px] text-gray-400 mb-1">
        <span class="truncate max-w-[90px]">{{ product.category }}</span>
        {% if product.location %}
          <span class="inline-flex items-center gap-0.5 text-gray-500 shrink-0">
            {{ icon("location", "w-2.5 h-2.5 text-gray-400") }}
            <span>{{ product.location }}</span>
          </span>
        {% endif %}
      </div>

      <!-- Product Title -->
      <a
        href="{{ targetUrl }}"
        class="text-xs sm:text-sm font-bold text-gray-800 group-hover:text-primary transition-colors line-clamp-2 leading-snug mb-2 min-h-[36px] sm:min-h-[40px]"
        title="{{ product.name }}"
      >
        {{ product.name }}
      </a>

      <!-- Price Row -->
      <!-- Price Row & Action Buttons -->
      <div class="mt-auto">
        <div class="flex items-baseline gap-1.5 flex-wrap mb-2">
          <span class="text-sm sm:text-base font-extrabold text-rose-600">
            {{ product.price }}
          </span>
          {% if showOriginalPrice and product.originalPrice %}
            <span class="text-[11px] sm:text-xs text-gray-400 line-through">
              {{ product.originalPrice }}
            </span>
          {% endif %}
        </div>

        <!-- Action Buttons: Mua ngay & Thêm vào giỏ hàng -->
        <div class="flex items-center gap-1.5 pt-2 border-t border-gray-100/80">
          <button
            type="button"
            class="flex-1 btn-noise bg-primary hover:bg-[#07332e] text-white text-[11px] sm:text-xs font-semibold py-1.5 sm:py-2 px-2 rounded-xl text-center transition-all duration-200 shadow-xs hover:shadow-md active:scale-[0.98] cursor-pointer"
          >
            Mua ngay
          </button>
          <button
            type="button"
            class="w-8 h-8 sm:w-8.5 sm:h-8.5 rounded-xl  hover:bg-emerald-100 text-primary border border-emerald-100/80 flex items-center justify-center transition-all duration-200 active:scale-95 cursor-pointer shrink-0"
            title="Thêm vào giỏ hàng"
            aria-label="Thêm vào giỏ hàng"
          >
            {{ icon("cart", "w-3.5 h-3.5 sm:w-4 sm:h-4") }}
          </button>
        </div>
      </div>
    </div>
  </div>
{% endmacro %}

{# Hỗ trợ sử dụng cả dạng include #}
{%- if product -%}
  {{ productItem(product, badgeType or "auto", showOriginalPrice if showOriginalPrice is defined else true, class or "") }}
{%- endif -%}
